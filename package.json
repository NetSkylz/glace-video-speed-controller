{
  "name": "glace-video-speed-controller",
  "version": "1.0.0",
  "private": true,
  "description": "A small, frosted-glass video speed controller for Chrome.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
